# Firebase web app config — copy to .env and fill with values from the Firebase console.
# All VITE_* vars are exposed to the client by Vite. Firebase web API keys are NOT secrets
# (they identify the project, not authorize access) — access control is enforced by
# Firestore/Storage security rules and App Check. Never put server-only secrets here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key for Firebase App Check (anti-abuse / rate limiting).
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Stripe publishable key (client-public, pk_test_* / pk_live_*). When empty, the family
# setup wizard falls back to a "card at launch" path — real card capture activates once
# this is set AND the billing Cloud Functions are deployed (Blaze). The Stripe SECRET key
# is NEVER placed here — it lives in Cloud Functions secrets (firebase functions:secrets:set).
VITE_STRIPE_PUBLISHABLE_KEY=

# Real card capture requires the key above AND this flag set to exactly "true" (DECISIONS D70).
# Left unset, the setup wizard uses the "add a card later" fallback — the launch posture while
# billing is off. Flip to "true" only alongside a pk_live_ key and enabling billing in Settings.
# VITE_BILLING_LIVE=true

# Set to "true" to connect to local Firebase emulators during development.
VITE_USE_FIREBASE_EMULATORS=false

# Mandatory TOTP two-factor. Enforced by default — leave this UNSET for staging/prod. Set to
# the literal "false" ONLY for local dev / the `npm run demo` walkthrough (the emulator has no
# Identity Platform backend, so TOTP can't work there). Any value other than "false" enforces.
# VITE_REQUIRE_MFA=false

# No-functions beta flag. Set to "true" in a build that is hosted WITHOUT Cloud Functions
# (Spark plan) — it shows an honest "we're in beta, no emails yet" notice and swaps the
# "we'll email you" copy for in-app status. Remove once functions/email are deployed (Blaze).
# VITE_BETA_NO_EMAIL=true
