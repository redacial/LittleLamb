rules_version = '2';

// Little Lamb Nannies — Firestore security rules.
// Default posture: DENY. Each collection opens only the minimum surface it needs.
// Authorization is decided server-side from the caller's users/{uid} doc — the client's
// claimed role/approval is never trusted. No open reads or writes anywhere (CLAUDE.md).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()));
    }
    function isAdmin() { return hasUserDoc() && userDoc().role == 'admin'; }
    function isApproved() { return hasUserDoc() && userDoc().approved == true; }
    function hasRole(role) { return hasUserDoc() && userDoc().role == role; }

    // Approved + non-admin members can browse the directory of approved nannies, etc.
    function isApprovedMember() { return isApproved() || isAdmin(); }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // String length guard for sanitized writes (defense in depth alongside client sanitize).
    function strMax(field, n) {
      return !(field in incoming()) || (incoming()[field] is string && incoming()[field].size() <= n);
    }

    // ---- users ---------------------------------------------------------------
    // The trust-critical doc. A user may create only their OWN doc, and only as a
    // non-admin, non-approved pending account. They may update only safe self-service
    // fields — never role, approved, or status (those are admin-only transitions).
    match /users/{userId} {
      allow get: if isSignedIn() && (uid() == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn()
        && uid() == userId
        && incoming().uid == userId
        && incoming().role in ['family', 'nanny']     // cannot self-create an admin
        && incoming().approved == false                // cannot self-approve
        && incoming().status == 'pending'
        && incoming().wizardComplete == false
        && strMax('fullName', 80) && strMax('email', 254) && strMax('phone', 32);

      // Self updates: cannot touch role/approved/status (privilege fields).
      allow update: if isSignedIn() && uid() == userId
        && incoming().role == existing().role
        && incoming().approved == existing().approved
        && incoming().status == existing().status
        && incoming().uid == existing().uid;

      // Admin updates: full control (approve/reject, advance nanny stage, etc.).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- families ------------------------------------------------------------
    // A family's own profile + onboarding progress. Readable by the owner and admin only —
    // family home addresses / children are never public.
    match /families/{familyId} {
      allow get: if isSignedIn() && (uid() == familyId || isAdmin());
      allow list: if isAdmin();

      // Billing fields are server-authoritative: hasPaymentMethod and stripeCustomerId are
      // written ONLY by the savePaymentMethod Cloud Function. A family may not set or change
      // them (create: must be absent/false; update: must equal the existing value).
      function billingFieldsUntouchedOnCreate() {
        return (!('hasPaymentMethod' in incoming()) || incoming().hasPaymentMethod == false)
          && !('stripeCustomerId' in incoming());
      }
      function billingFieldsUnchangedOnUpdate() {
        return (('hasPaymentMethod' in incoming()) ? incoming().hasPaymentMethod : false)
             == (('hasPaymentMethod' in existing()) ? existing().hasPaymentMethod : false)
          && (('stripeCustomerId' in incoming()) ? incoming().stripeCustomerId : null)
             == (('stripeCustomerId' in existing()) ? existing().stripeCustomerId : null);
      }

      allow create: if isSignedIn() && uid() == familyId && hasRole('family')
        && incoming().uid == familyId
        && strMax('homeAddress', 300) && strMax('neighborhood', 120)
        && strMax('houseRules', 2000) && strMax('allergies', 1000)
        && billingFieldsUntouchedOnCreate();
      allow update: if isSignedIn() && uid() == familyId && hasRole('family')
        && incoming().uid == familyId
        && strMax('homeAddress', 300) && strMax('neighborhood', 120)
        && strMax('houseRules', 2000) && strMax('allergies', 1000)
        && billingFieldsUnchangedOnUpdate();
      allow update, delete: if isAdmin();
    }

    // ---- nannies -------------------------------------------------------------
    // Public-facing profile. Owner writes it; any APPROVED member (family/nanny) or admin
    // can read it (the directory + profile pages). Verified badges are admin-controlled:
    // a nanny update must not change verifiedBadges.
    match /nannies/{nannyId} {
      allow get: if isApprovedMember() || (isSignedIn() && uid() == nannyId);
      allow list: if isApprovedMember();

      // First write: owner provisions their profile but may NOT seed verified badges — those
      // are admin-only certifications, so verifiedBadges must be absent or empty on create.
      allow create: if isSignedIn() && uid() == nannyId && hasRole('nanny')
        && incoming().uid == nannyId
        && strMax('fullName', 80) && strMax('bio', 600) && strMax('personalStatement', 1000)
        && (!('verifiedBadges' in incoming()) || incoming().verifiedBadges.size() == 0);

      // Subsequent owner edits: verifiedBadges is immutable from the client side.
      allow update: if isSignedIn() && uid() == nannyId && hasRole('nanny')
        && incoming().uid == nannyId
        && strMax('fullName', 80) && strMax('bio', 600) && strMax('personalStatement', 1000)
        && (!('verifiedBadges' in incoming()) || incoming().verifiedBadges == existing().verifiedBadges);

      allow update, delete: if isAdmin();
    }

    // ---- bookings ------------------------------------------------------------
    // A family sees its own bookings; a nanny sees bookings assigned to them plus
    // open/unmatched ones they could pick up; admin sees all.
    match /bookings/{bookingId} {
      // read = get + list. By gating on the doc itself, Firestore only accepts list queries
      // whose constraints guarantee every returned doc satisfies this rule — i.e. a family can
      // only run a familyId==self query, a nanny only nannyId==self or status in open/unmatched.
      // An unscoped "read all bookings" query is rejected for non-admins. (Audit fix §3/§7.)
      allow read: if isSignedIn() && (
        isAdmin()
        || existing().familyId == uid()
        || existing().nannyId == uid()
        || (hasRole('nanny') && existing().status in ['open', 'unmatched'])
      );

      // Family creates its own booking request. Nanny/admin may not impersonate a family.
      allow create: if isSignedIn() && hasRole('family') && isApproved()
        && incoming().familyId == uid()
        && strMax('notes', 1000) && strMax('address', 300);

      // Family can update/cancel its own booking; assigned nanny can accept/decline; admin all.
      allow update: if isSignedIn() && (
        existing().familyId == uid()
        || existing().nannyId == uid()
        || (hasRole('nanny') && existing().status in ['open', 'unmatched'])
        || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ---- invoices ------------------------------------------------------------
    // Family reads its own invoices; only admin/billing system writes them.
    match /invoices/{invoiceId} {
      allow get: if isSignedIn() && (existing().familyId == uid() || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- billing_alerts ------------------------------------------------------
    // Server-written failed-payment flags for the admin dashboard. Admin-read-only;
    // no client writes ever (the billing functions run with admin privileges).
    match /billing_alerts/{alertId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- stripe_events -------------------------------------------------------
    // Webhook replay-protection markers, written ONLY by the stripeWebhook function via
    // the Admin SDK (which bypasses these rules). No client may read or write them —
    // spelled out explicitly rather than left to the catch-all deny so the collection's
    // server-only nature is documented where the other billing collections are.
    match /stripe_events/{eventId} {
      allow read, write: if false;
    }

    // ---- reviews -------------------------------------------------------------
    // Reviews are ADMIN-ONLY to read (never public-facing, per spec). An author may create a
    // review for a booking they were part of; nobody but admin can read them back.
    match /reviews/{reviewId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && isApproved()
        && incoming().authorId == uid()
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && strMax('comment', 2000);
      allow update, delete: if isAdmin();
    }

    // ---- referrals -----------------------------------------------------------
    // Owner reads their own referral record; admin reads all. Signup attribution is written
    // through the users doc, so referral docs are admin-managed aggregates.
    match /referrals/{code} {
      allow get: if isSignedIn() && (existing().ownerId == uid() || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ---- platform config (badges master list, email templates, policies, billing cfg) ----
    // Public-readable config that admin maintains in Settings.
    match /config/{docId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- waitlist ------------------------------------------------------------
    // Pre-launch landing site: PUBLIC create-only, admin read-only. Anyone (signed-out
    // visitors included) may add ONE waitlist/contact submission; nobody but admin can read,
    // list, update, or delete — so the collection can never be enumerated to harvest the
    // emails of everyone who signed up. The create surface is public, so the shape is validated
    // strictly to keep it from being abused as arbitrary storage. App Check (when configured)
    // further attests the write comes from our real site. Email-on-signup is a deferred Cloud
    // Function (see src/landing/waitlist.ts) that runs with admin privileges, unaffected by these.
    match /waitlist/{entryId} {
      allow get, list, update, delete: if isAdmin();

      allow create: if
        // exact field set — no extra keys can be smuggled in
        incoming().keys().hasOnly(['kind', 'role', 'name', 'email', 'phone', 'message',
                                   'source', 'status', 'createdAt'])
        && incoming().kind in ['waitlist', 'contact']
        && incoming().role in ['family', 'nanny']
        && incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 120
        && incoming().email is string && incoming().email.size() > 0 && incoming().email.size() <= 254
        && incoming().phone is string && incoming().phone.size() <= 32
        && incoming().message is string && incoming().message.size() <= 2000
        && incoming().source is string && incoming().source.size() <= 300
        && incoming().status == 'new'
        && incoming().createdAt == request.time;   // server timestamp only, no client-set dates
    }

    // ---- mail (outbound email queue) ----------------------------------------
    // The client's notify() writes a request doc here; a Cloud Function (admin
    // privileges) reads it, sends via the email provider, and updates status.
    // Create-only for signed-in users, admin-read-only — like waitlist, it can never
    // be enumerated, and the envelope is shape-validated so it can't be abused as
    // arbitrary storage. `event` is an opaque map (the function validates its type);
    // we require a known event.type string and forbid a client-set status other than
    // 'pending' or a client-set timestamp. Only the function (admin) may update.
    match /mail/{mailId} {
      allow get, list: if isAdmin();

      allow create: if isSignedIn()
        && incoming().keys().hasOnly(['event', 'status', 'createdAt'])
        && incoming().status == 'pending'
        && incoming().createdAt == request.time
        && incoming().event is map
        && incoming().event.type is string
        && incoming().event.type in [
             'booking_auto_confirmed', 'booking_request_sent', 'booking_request_accepted',
             'booking_request_declined', 'open_booking_picked_up',
             'recurring_booking_auto_cancelled', 'same_day_booking_outcome',
             'booking_cancelled_by_family', 'application_status_updated',
             'application_approved', 'application_rejected'
           ];

      allow update, delete: if isAdmin();
    }

    // ---- default deny --------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
