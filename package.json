{
  "name": "littlelamb-nannies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --open /landing.html",
    "build": "tsc -b && vite build",
    "build:app:staging": "tsc -b && vite build --mode staging",
    "build:app:prod": "tsc -b && vite build --mode production",
    "build:landing": "tsc -b && BUILD_TARGET=landing vite build --mode ${LANDING_MODE:-production} && node -e \"const fs=require('fs');fs.renameSync('dist-landing/landing.html','dist-landing/index.html')\"",
    "build:landing:staging": "LANDING_MODE=staging npm run build:landing",
    "build:landing:prod": "LANDING_MODE=production npm run build:landing",
    "preview:landing": "vite preview --outDir dist-landing",
    "preview": "vite preview",
    "deploy:landing:staging": "npm run build:landing:staging && firebase use staging && firebase deploy --only hosting:landing,firestore:rules --project littlelamb-sb-staging",
    "deploy:landing:prod": "npm run build:landing:prod && firebase use prod && firebase deploy --only hosting:landing,firestore:rules --project littlelamb-sb",
    "deploy:app:staging": "npm run build:app:staging && firebase use staging && firebase deploy --only hosting:app --project littlelamb-sb-staging",
    "deploy:app:prod": "npm run build:app:prod && firebase use prod && firebase deploy --only hosting:app --project littlelamb-sb",
    "deploy:rules:staging": "firebase deploy --only firestore:rules --project littlelamb-sb-staging",
    "deploy:rules:prod": "firebase deploy --only firestore:rules --project littlelamb-sb",
    "deploy:indexes:staging": "firebase deploy --only firestore:indexes --project littlelamb-sb-staging",
    "deploy:indexes:prod": "firebase deploy --only firestore:indexes --project littlelamb-sb",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:functions": "npm --prefix functions test",
    "test:rules": "npm --prefix firestore-tests test",
    "test:all": "npm test && npm run test:functions && npm run test:rules",
    "deploy:functions:staging": "firebase deploy --only functions --project littlelamb-sb-staging",
    "deploy:functions:prod": "firebase deploy --only functions --project littlelamb-sb",
    "emulators": "firebase emulators:start --only auth,firestore,storage,functions",
    "seed": "node scripts/seed.mjs",
    "preview:local": "firebase emulators:exec --only auth,firestore,storage \"npm run seed && npm run dev\""
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^5.10.0",
    "firebase": "^12.14.0",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-admin": "^14.0.0",
    "firebase-tools": "^15.20.0",
    "globals": "^15.15.0",
    "jsdom": "^24.1.0",
    "playwright": "^1.61.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1"
  }
}
